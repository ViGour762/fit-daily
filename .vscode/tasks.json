{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动本地预览（http://127.0.0.1:5173）",
      "type": "shell",
      "command": "node scripts/dev-server.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "本地预览已启动",
          "endsPattern": "^$"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "运行测试（核心算法）",
      "type": "shell",
      "command": "node tests/core.test.js",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always" }
    },
    {
      "label": "集成冒烟测试（加载全部脚本）",
      "type": "shell",
      "command": "node tests/app.smoke.js",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "检查样式类覆盖",
      "type": "shell",
      "command": "node scripts/check-css.js",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "生成 PWA 图标",
      "type": "shell",
      "command": "python scripts/generate-icons.py",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    }
  ]
}